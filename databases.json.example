{
  "enableMonitorConfig": false,
  "databases": [
    {
      "name": "mysql-main",
      "connectionString": "Server=localhost;Port=3306;Database=myapp;User=root;Password=123456;Charset=utf8mb4;AllowLoadLocalInfile=true;Min Pool Size=1;Max Pool Size=100;Allow User Variables=True;Pooling=true;",
      "dbType": "MySql",
      "description": "MySQL 主库（utf8mb4 + 连接池 + BulkCopy）",
      "isDefault": true,
      "enableDangerousOperations": false,
      "optimizationSettings": {
        "enableBulkCopy": "true",
        "maxPoolSize": "100",
        "charset": "utf8mb4"
      }
    },
    {
      "name": "postgres-analytics",
      "connectionString": "Host=localhost;Port=5432;Database=analytics;Username=postgres;Password=123456;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=100;Timeout=30;Command Timeout=30;",
      "dbType": "PostgreSQL",
      "description": "PostgreSQL 分析库（表名小写 + ILIKE）",
      "optimizationSettings": {
        "autoToLower": "true",
        "enableILike": "true",
        "identityStrategy": "Serial"
      }
    },
    {
      "name": "sqlserver-crm",
      "connectionString": "Server=localhost;Database=crm;User Id=sa;Password=123456;Encrypt=True;TrustServerCertificate=True;Min Pool Size=1;Max Pool Size=100;",
      "dbType": "SqlServer",
      "description": "SQL Server CRM（NoLock + 可禁用 nvarchar）",
      "optimizationSettings": {
        "disableNvarchar": "true",
        "enableNoLock": "true",
        "disableNoLockWithTran": "true"
      }
    },
    {
      "name": "oracle-erp",
      "connectionString": "Data Source=localhost/orcl;User ID=system;Password=oracle123;Pooling=true;Min Pool Size=5;Max Pool Size=150;",
      "dbType": "Oracle",
      "description": "Oracle ERP（大连接池 + 自增）",
      "optimizationSettings": {
        "enableIdentity": "true",
        "maxParamLength": "30",
        "camelCase": "false"
      }
    },
    {
      "name": "sqlite-local",
      "connectionString": "Data Source=./data/local.db;Cache=Shared;Mode=ReadWriteCreate;",
      "dbType": "Sqlite",
      "description": "SQLite 本地库（共享缓存 + CodeFirst 增强）",
      "optimizationSettings": {
        "enableDefaultValue": "true",
        "enableDescription": "true",
        "enableDropColumn": "true"
      }
    },
    {
      "name": "mongodb-doc",
      "connectionString": "mongodb://root:123456@localhost:27017/mydb?authSource=admin",
      "dbType": "MongoDb",
      "description": "MongoDB 文档库（单表 CRUD/分页/简单联表）"
    },
    {
      "name": "clickhouse-olap",
      "connectionString": "Host=localhost;Port=8123;User=default;Password=;Database=default",
      "dbType": "ClickHouse",
      "description": "ClickHouse 分析库（列式/批量写入）",
      "optimizationSettings": {
        "maxPoolSize": "50"
      }
    },
    {
      "name": "tidb-bigdata",
      "connectionString": "Server=localhost;Port=4000;Database=bigdata;User=root;Password=123456;Charset=utf8mb4;Pooling=true;Min Pool Size=1;Max Pool Size=50;",
      "dbType": "Tidb",
      "description": "TiDB 分布式数据库（Hints + 悲观事务可选）",
      "optimizationSettings": {
        "enableHints": "true",
        "pessimisticTxn": "true",
        "enableBulkCopy": "true",
        "maxPoolSize": "50",
        "disableNvarchar": "false"
      }
    },
    {
      "name": "oceanbase-mysql",
      "connectionString": "Server=localhost;Port=2881;Database=test;User=root@sys;Password=password;Charset=utf8mb4;Pooling=true;",
      "dbType": "OceanBase",
      "description": "OceanBase MySQL 模式（租户隔离 + 可选禁用连接池）",
      "optimizationSettings": {
        "tenantMode": "mysql",
        "enableHints": "true",
        "disablePooling": "false",
        "maxPoolSize": "100"
      }
    },
    {
      "name": "oceanbase-oracle",
      "connectionString": "Driver={OceanBase ODBC 2.0 Driver};Server=172.19.9.9;Port=2883;Database=XIR_TRD;User=XIR_TRD@TENANT#CLUSTER:1650773680;Password=strong_pwd;Option=3;",
      "dbType": "OceanBaseForOracle",
      "description": "OceanBase Oracle 模式（ODBC + Oracle 兼容）",
