{
  "mcpServers": {
    "// 方式 1: 配置文件方式（推荐 - 多数据库）": "",
    "database-config-file": {
      "command": "DatabaseMcpServer",
      "env": {
        "DB_CONFIG_PATH": "D:\\config\\databases.json"
      }
    },

    "// 方式 2: 环境变量方式（单数据库模式）": "",
    "database-env": {
      "command": "DatabaseMcpServer",
      "env": {
        "DB_CONNECTION_STRING": "Server=localhost;Database=test;Uid=root;Pwd=123456;",
        "DB_TYPE": "MySql"
      }
    },

    "// 本地开发 - 使用源码运行": "",
    "database-dev": {
      "command": "dotnet",
      "args": ["run", "--project", "path/to/DatabaseMcpServer"],
      "env": {
        "DB_CONFIG_PATH": "D:\\config\\databases.json"
      }
    },

    "// NuGet 包部署": "",
    "database-nuget": {
      "command": "dnx",
      "args": ["DatabaseMcpServer", "--version", "1.0.6", "--yes"],
      "env": {
        "DB_CONNECTION_STRING": "Server=localhost;Database=prod;Uid=root;Pwd=prod_password;",
        "DB_TYPE": "MySql"
      }
    }
  },

  "// 配置文件格式 (databases.json)": {
    "databases": [
      {
        "name": "mysql-main",
        "connectionString": "Server=localhost;Port=3306;Database=myapp;User=root;Password=123456;",
        "dbType": "MySql",
        "description": "MySQL 主库",
        "isDefault": true
      },
      {
        "name": "postgres-analytics",
        "connectionString": "Host=localhost;Port=5432;Database=analytics;Username=postgres;Password=123456;",
        "dbType": "PostgreSQL",
        "description": "PostgreSQL 分析库"
      },
      {
        "name": "sqlserver-crm",
        "connectionString": "Server=localhost;Database=crm;User Id=sa;Password=123456;",
        "dbType": "SqlServer",
        "description": "SQL Server CRM 库"
      }
    ]
  },

  "// 数据库配置示例": {
    "// 主流数据库": "",
    "MySQL": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=3306;Database=mydb;User=root;Password=123456;",
      "DB_TYPE": "MySql"
    },

    "SQL Server": {
      "DB_CONNECTION_STRING": "Server=localhost;Database=mydb;User Id=sa;Password=123456;",
      "DB_TYPE": "SqlServer"
    },

    "SQLite": {
      "DB_CONNECTION_STRING": "Data Source=mydb.db;",
      "DB_TYPE": "Sqlite"
    },

    "PostgreSQL": {
      "DB_CONNECTION_STRING": "Host=localhost;Port=5432;Database=mydb;Username=postgres;Password=123456;",
      "DB_TYPE": "PostgreSQL"
    },

    "Oracle": {
      "DB_CONNECTION_STRING": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=orcl)));User Id=system;Password=123456;",
      "DB_TYPE": "Oracle"
    },

    "// 国产数据库": "",
    "达梦数据库": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=5236;Database=mydb;User=SYSDBA;Password=SYSDBA001;",
      "DB_TYPE": "dm"
    },

    "人大金仓": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=54321;Database=mydb;User=SYSTEM;Password=MANAGER;",
      "DB_TYPE": "kdbndp"
    },

    "神通数据库": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=2003;Database=mydb;User=SYSDBA;Password=SYSDBA;",
      "DB_TYPE": "oscar"
    },

    "瀚高数据库": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=5866;Database=mydb;User=postgres;Password=123456;",
      "DB_TYPE": "hg"
    },

    "// 分布式数据库": "",
    "OceanBase": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=2881;Database=mydb;User=root@sys;Password=123456;",
      "DB_TYPE": "oceanbase"
    },

    "TiDB": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=4000;Database=mydb;User=root;Password=123456;",
      "DB_TYPE": "tidb"
    },

    "// 时序数据库": "",
    "TDengine": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=6030;Database=mydb;User=root;Password=taosdata;",
      "DB_TYPE": "tdengine"
    },

    "ClickHouse": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=9000;Database=mydb;User=default;Password=123456;",
      "DB_TYPE": "clickhouse"
    },

    "// 分析型数据库": "",
    "DuckDB": {
      "DB_CONNECTION_STRING": "Data Source=mydb.duckdb;",
      "DB_TYPE": "duckdb"
    },

    "Doris": {
      "DB_CONNECTION_STRING": "Server=localhost;Port=9030;Database=mydb;User=root;Password=123456;",
      "DB_TYPE": "doris"
    }
  },

  "// 环境变量说明": {
    "DB_CONFIG_PATH": "（二选一）配置文件绝对路径，如 D:\\config\\databases.json",
    "DB_CONNECTION_STRING": "（二选一）数据库连接字符串",
    "DB_TYPE": "（可选）数据库类型，默认 MySql。支持：主流数据库(MySql, SqlServer, Sqlite, PostgreSQL, Oracle)、国产数据库(dm, kdbndp, kingbase, oscar, hg, gbase, xugu, vastbase, goldendb)、分布式数据库(oceanbase, tidb, polardb, doris)、时序数据库(tdengine, questdb, clickhouse)、其他数据库(duckdb, access, odbc, hana, db2, mongodb, custom)等",
    "SEQ_SERVER_URL": "（可选）Seq日志服务器地址",
    "SEQ_API_KEY": "（可选）Seq API密钥"
  },

  "// 配置优先级": {
    "1": "DB_CONFIG_PATH（最高优先级）- 如果设置，只使用配置文件",
    "2": "DB_CONNECTION_STRING + DB_TYPE - 如果未设置 DB_CONFIG_PATH，使用环境变量",
    "3": "两种都未配置 - 启动时报错"
  },

  "// 使用说明": {
    "1": "复制此文件到你的IDE配置目录",
    "2": "VS Code: <WORKSPACE>/.vscode/mcp.json",
    "3": "Visual Studio: <SOLUTION>/.mcp.json",
    "4": "选择配置方式（配置文件或环境变量）",
    "5": "修改连接字符串和数据库类型",
    "6": "重启IDE或重新加载MCP配置"
  }
}
