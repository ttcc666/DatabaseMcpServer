{
  "mcpServers": {
    "// 方式 1: .NET Global Tool（推荐）": "",
    "database": {
      "command": "DatabaseMcpServer",
      "env": {
        "DB_CONFIG_PATH": "D:\\config\\databases.json"
      }
    },

    "// 方式 2: dnx 命令": "",
    "database-dnx": {
      "command": "dnx",
      "args": ["DatabaseMcpServer@2.1.1", "--yes"],
      "env": {
        "DB_CONFIG_PATH": "D:\\config\\databases.json"
      }
    },

    "// 方式 3: 本地开发 - 使用源码运行（多目标项目请指定 --framework）": "",
    "database-dev": {
      "command": "dotnet",
      "args": ["run", "--framework", "net9.0", "--project", "path/to/DatabaseMcpServer"],
      "env": {
        "DB_CONFIG_PATH": "D:\\config\\databases.json"
      }
    },
    "database-dev-net10": {
      "command": "dotnet",
      "args": ["run", "--framework", "net10.0", "--project", "path/to/DatabaseMcpServer"],
      "env": {
        "DB_CONFIG_PATH": "D:\\config\\databases.json"
      }
    },

    "// 可选: 配置日志服务器": "",
    "database-with-logging": {
      "command": "DatabaseMcpServer",
      "env": {
        "DB_CONFIG_PATH": "D:\\config\\databases.json",
        "SEQ_SERVER_URL": "http://localhost:5341",
        "SEQ_API_KEY": "your-seq-api-key"
      }
    }
  },

  "// 配置文件格式 (databases.json)": {
    "databases": [
      {
        "name": "mysql-main",
        "connectionString": "Server=localhost;Port=3306;Database=myapp;User=root;Password=123456;Charset=utf8mb4;",
        "dbType": "MySql",
        "description": "MySQL 主库",
        "isDefault": true,
        "optimizationSettings": {
          "enableBulkCopy": "true",
          "maxPoolSize": "100"
        }
      },
      {
        "name": "postgres-analytics",
        "connectionString": "Host=localhost;Port=5432;Database=analytics;Username=postgres;Password=123456;",
        "dbType": "PostgreSQL",
        "description": "PostgreSQL 分析库",
        "optimizationSettings": {
          "autoToLower": "true",
          "enableILike": "true"
        }
      },
      {
        "name": "sqlserver-crm",
        "connectionString": "Server=localhost;Database=crm;User Id=sa;Password=123456;",
        "dbType": "SqlServer",
        "description": "SQL Server CRM 库",
        "optimizationSettings": {
          "disableNvarchar": "true"
        }
      }
    ]
  },

  "// 常用数据库连接字符串示例": {
    "MySQL": "Server=localhost;Port=3306;Database=mydb;User=root;Password=123456;Charset=utf8mb4;",
    "SQL Server": "Server=localhost;Database=mydb;User Id=sa;Password=123456;",
    "PostgreSQL": "Host=localhost;Port=5432;Database=mydb;Username=postgres;Password=123456;",
    "Oracle": "Data Source=localhost/orcl;User ID=system;Password=oracle123;",
    "SQLite": "Data Source=mydb.db;",
    "MongoDB": "mongodb://root:123456@localhost:27017/mydb?authSource=admin",
    "TiDB": "Server=localhost;Port=4000;Database=mydb;User=root;Password=123456;Pooling=true;",
    "OceanBase (MySQL)": "Server=localhost;Port=2881;Database=mydb;User=root@sys;Password=123456;",
    "OceanBase (Oracle)": "Driver={OceanBase ODBC 2.0 Driver};Server=172.19.9.9;Port=2883;Database=TRD;User=USER@TENANT#CLUSTER:xxx;Password=123456;Option=3;",
    "QuestDB": "host=localhost;port=8812;username=admin;password=quest;database=qdb;ServerCompatibilityMode=NoTypeLoading;",
    "TDengine": "Host=localhost;Port=6030;Username=root;Password=taosdata;Database=power",
    "DuckDB": "DataSource=train_services.db",
    "Doris": "Server=localhost;Database=mydb;Uid=root;Pwd=123456;Pooling=false;",
    "ClickHouse": "Host=localhost;Port=8123;User=default;Password=;Database=default",
    "GBase 8s": "Host=localhost;Service=19088;Server=gbase01;Database=testdb;Protocol=onsoctcp;Uid=gbasedbt;Pwd=GBase123;Db_locale=zh_CN.utf8;Client_locale=zh_CN.utf8",
    "PolarDB": "Server=localhost;Port=3306;Database=mydb;Uid=root;Pwd=123456;Pooling=false;",
    "GaussDB/OpenGauss": "PORT=5432;DATABASE=mydb;HOST=localhost;PASSWORD=Gauss@123;USER ID=gaussdb;No Reset On Close=true;",
    "达梦数据库": "Server=localhost;Port=5236;Database=mydb;User=SYSDBA;Password=SYSDBA001;",
    "人大金仓": "Server=localhost;Port=54321;Database=mydb;User=SYSTEM;Password=system123;",
    "瀚高数据库": "Server=27.151.1.54;Port=5866;UId=design;Password=000;Database=design;searchpath=design;Pooling=false;",
    "Vastbase": "PORT=5432;DATABASE=demo;HOST=localhost;USER ID=postgres;PASSWORD=pass;No Reset On Close=true",
    "GoldenDB": "Server=localhost;Port=3306;Database=mydb;Uid=root;Pwd=123456;Pooling=false;",
    "Oscar": "Data Source=localhost;User Id=sysdba;Password=oscar;",
    "Kdbndp (KingbaseES)": "Server=localhost;Port=54321;Database=mydb;User=SYSTEM;Password=system123;",
    "GBase": "Host=localhost;Service=19088;Server=gbase01;Database=testdb;Protocol=onsoctcp;Uid=gbasedbt;Pwd=GBase123;Db_locale=zh_CN.utf8;Client_locale=zh_CN.utf8",
    "详细配置": "请参考 DatabaseSetting/ 目录下的各数据库配置文档"
  },

  "// 环境变量说明": {
    "DB_CONFIG_PATH": "（必需）数据库配置文件绝对路径，如 D:\\config\\databases.json",
    "SEQ_SERVER_URL": "（可选）Seq 日志服务器地址，如 http://localhost:5341",
    "SEQ_API_KEY": "（可选）Seq API 密钥",
    "DB_DDL_WHITELIST": "（可选）DDL 操作白名单（分号分隔的正则表达式）"
  },

  "// 优化配置选项 (optimizationSettings)": {
    "说明": "从 2.0.0 版本开始，所有数据库特定优化配置都在 databases.json 的 optimizationSettings 中设置",
    "MySQL/兼容 (MySql/Tidb/PolarDB/Doris/GBase/GoldenDB/OceanBase-MySQL)": {
      "enableBulkCopy": "启用批量导入优化（需 AllowLoadLocalInfile=true）",
      "maxPoolSize": "连接池最大连接数",
      "charset": "字符集配置",
      "disableNvarchar": "少数兼容场景禁用 N'' 前缀",
      "disablePooling": "特殊网络/兼容问题时设为 true（Pooling=false）"
    },
    "SQL Server": {
      "disableNvarchar": "禁用 nvarchar（性能优化）",
      "enableNoLock": "自动 WITH(NOLOCK)",
      "disableNoLockWithTran": "事务内禁用 NoLock"
    },
    "PostgreSQL/兼容 (PostgreSQL/Vastbase/HighGo/Kdbndp-PG/ GaussDB/OpenGauss)": {
      "autoToLower": "自动转小写表名",
      "enableILike": "启用 ILIKE 支持",
      "identityStrategy": "Serial 或 Identity",
      "noResetOnClose": "建议 true (No Reset On Close=true)"
    },
    "Oracle/OceanBase-Oracle": {
      "camelCase": "使用驼峰表名",
      "enableIdentity": "启用原生自增",
      "maxParamLength": "参数名最大长度",
      "disableNvarchar": "特殊字符/索引问题时可禁用"
    },
    "SQLite": {
      "enableDefaultValue": "启用默认值支持",
      "enableDescription": "启用描述支持",
      "enableDropColumn": "启用删除列支持"
    },
    "ClickHouse": {
      "maxPoolSize": "连接池提示（非事务）"
    },
    "TDengine/DuckDB/QuestDB": {
      "说明": "主要依赖驱动/连接串，无额外可调项"
    },
    "MongoDB": {
      "说明": "无导航/子查询，支持 CRUD/分页/简单联表/事务（副本集）"
    },
    "其他": "请参考 DatabaseSetting/ 目录下的各数据库配置文档"
  },

  "// 使用说明": {
    "1": "创建 databases.json 配置文件（参考上面的配置文件格式）",
    "2": "复制此文件到你的 IDE 配置目录",
    "3": "VS Code: <WORKSPACE>/.vscode/mcp.json",
    "4": "Visual Studio: <SOLUTION>/.mcp.json",
    "5": "修改 DB_CONFIG_PATH 指向你的 databases.json 文件",
    "6": "重启 IDE 或重新加载 MCP 配置"
  },

  "// 从 1.x 迁移到 2.0": {
    "说明": "DatabaseMcpServer 2.0.0 移除了环境变量配置方式，统一使用 JSON 配置文件",
    "旧方式": "DB_CONNECTION_STRING + DB_TYPE 环境变量",
    "新方式": "DB_CONFIG_PATH 指向 databases.json 配置文件",
    "迁移步骤": "1. 创建 databases.json 文件 2. 将连接字符串和数据库类型移到 JSON 中 3. 更新 MCP 配置只保留 DB_CONFIG_PATH",
    "详细指南": "请参考 README.md 中的迁移指南章节"
  }
}
